# Server Port
PORT=5000

# Neon Cloud PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Initial Admin Seeding (Optional)
INITIAL_ADMIN_EMAIL=admin@gjshospital.com
INITIAL_ADMIN_PASSWORD=AdminPass123!
INITIAL_RECEPTIONIST_EMAIL=receptionist@gjshospital.com
INITIAL_RECEPTIONIST_PASSWORD=RecepPass123!
